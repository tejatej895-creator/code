--SCD 1 SQL

MERGE INTO TGT_TABLE TGT
USING SOURCE_TABLE  SRC
ON TGT.ID = SRC.ID 

WHEN MATCHED THEN
UPDATE SET TGT.VALUE = SRC.VALUE , TGT.TIME = SRC.TIME

WHEN NOT MATCHED THEN
INSERT (ID , VALUE) 
VALUES (SRC.ID , SRC.VALUE)


--SCD 2 SQL

MERGE INTO TGT_TABLE TGT
USING SOURCE_TABLE  SRC
ON TGT.ID = SRC.ID 

WHEN MATCHED and tgt.value <> src.value THEN
UPDATE SET tgt.active = false 

WHEN MATCHED and tgt.value <> src.value THEN
INSERT (ID , VALUE , active) 
VALUES (SRC.ID , SRC.VALUE , true)

WHEN NOT MATCHED THEN
INSERT (ID , VALUE) 
VALUES (SRC.ID , SRC.VALUE)